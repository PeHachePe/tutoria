import { defineConfig } from 'vitest/config';

/**
 * Extra Vitest options for `ng test` (runnerConfig in angular.json); everything else stays in
 * angular.json.
 *
 * Coverage leaves out the guard that the Angular compiler writes before each message marked with
 * `i18n` in a template: `if (typeof ngI18nClosureMode !== 'undefined' && ngI18nClosureMode)
 * { goog.getMsg(…) } else { $localize… }`. The build replaces `ngI18nClosureMode` with `false` and
 * the guard reaches the bundle as `if (false)`, whose branch for Google's Closure Compiler can never
 * run. It is code generated by Angular that does not depend on us (D-010, D-023). Our own code never
 * has an `if (false)`: ESLint's `no-constant-condition` forbids it.
 */
export default defineConfig({
  test: {
    coverage: {
      ignoreNode: (node) =>
        node.type === 'IfStatement' && node.test.type === 'Literal' && node.test.value === false
          ? 'ignore-this-and-nested-nodes'
          : undefined,
    },
  },
});
