import type { CoverageV8Options } from 'vitest/node';
import { defineConfig } from 'vitest/config';

/**
 * Extra Vitest options for `ng test` (runnerConfig in angular.json); everything else stays in
 * angular.json.
 *
 * Coverage leaves out the guard that the Angular compiler writes before each message marked with
 * `i18n` in a template: `if (typeof ngI18nClosureMode !== 'undefined' && ngI18nClosureMode)
 * { goog.getMsg(…) } else { $localize… }`. The build replaces `ngI18nClosureMode` with `false` and
 * the guard reaches the bundle as `if (false)`, whose branch for Google's Closure Compiler can never
 * run. It is code generated by Angular that does not depend on us (D-010, D-023). Our own code never
 * has an `if (false)`: ESLint's `no-constant-condition` forbids it.
 *
 * It also leaves out the metadata a component with a `@defer` block gets for TestBed:
 * `ɵsetClassMetadataAsync(Component, () => [import(…)], (Deferred) => { ɵsetClassMetadata(…) })`.
 * Angular only calls that last function when a test overrides the component, which ours never do.
 * It is also code generated by Angular (D-010, D-029); we never write a call with that name.
 */
type Node = Parameters<NonNullable<CoverageV8Options['ignoreNode']>>[0];

function isClosureGuard(node: Node): boolean {
  return node.type === 'IfStatement' && node.test.type === 'Literal' && node.test.value === false;
}

/**
 * `(typeof ngDevMode === 'undefined' || ngDevMode) && ɵsetClassMetadataAsync(…)`, as a statement or as
 * the branch coverage sees in it. Coverage only offers statements, functions and branches, not calls.
 */
function isAsyncClassMetadata(node: Node): boolean {
  const expression = node.type === 'ExpressionStatement' ? node.expression : node;
  if (expression.type !== 'LogicalExpression' || expression.right.type !== 'CallExpression') {
    return false;
  }
  const callee = expression.right.callee;
  const name =
    callee.type === 'Identifier'
      ? callee.name
      : callee.type === 'MemberExpression' && callee.property.type === 'Identifier'
        ? callee.property.name
        : '';
  return name === 'ɵsetClassMetadataAsync';
}

export default defineConfig({
  test: {
    coverage: {
      ignoreNode: (node) =>
        isClosureGuard(node) || isAsyncClassMetadata(node)
          ? 'ignore-this-and-nested-nodes'
          : undefined,
    },
  },
});
