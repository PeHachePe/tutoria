{
  "name": "tutoria",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "build": "ng build",
    "build:demo": "ng build --configuration demo",
    "serve:demo": "node scripts/serve-demo.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "check": "prettier --check . && ng lint && ng test --watch=false && npm run test:scripts && npm run test:functions && npm run seed -- --check && npm run i18n -- --check",
    "format": "prettier --write .",
    "test:scripts": "node --test \".claude/hooks/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions",
    "metrics": "node scripts/metrics.mjs",
    "seed": "node scripts/generate-seed.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/app/data/supabase/database.types.ts && prettier --write src/app/data/supabase/database.types.ts",
    "e2e": "playwright test --project=e2e",
    "smoke": "playwright test --project=smoke",
    "screenshots": "node scripts/screenshots.mjs",
    "favicon": "node scripts/generate-favicon.mjs",
    "emojis": "node scripts/generate-reaction-emojis.mjs",
    "elusion": "node scripts/elusion.mjs",
    "i18n": "node scripts/i18n.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x || 26.x"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/roboto": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.119.0",
    "material-symbols": "^0.48.3",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "deno": "2.5.6",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "supabase": "3.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "upng-js": "^2.1.0",
    "vitest": "^5.0.0"
  }
}
